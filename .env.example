# ==============================================================================
# GapFinder AI - Environment Configuration
# ==============================================================================
# Place your real keys in a file named: .env.local
# Next.js will automatically load .env.local in development and production.

# ------------------------------------------------------------------------------
# 1. Primary AI Model: Google Gemini (Recommended)
# Get a free API key at: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 2. Fallback AI Model: Groq (Ultra-fast LLM generation)
# Get a free API key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# ------------------------------------------------------------------------------
# 3. Vector Database: Qdrant Cloud (Optional - in-memory BM25 works by default)
# Get a free cluster at: https://cloud.qdrant.io/
# ------------------------------------------------------------------------------
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION="gapfinder_materials"

# ------------------------------------------------------------------------------
# 4. Database & Auth: Supabase (Optional - browser local sandbox works by default)
# Get a free project at: https://supabase.com/
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
